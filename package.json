{
  "name": "zkp-policy-model-benchmarks",
  "private": true,
  "version": "1.0.0",
  "description": "Circom policy kernels aligned with a policy model for privacy-preserving payment systems",
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "snarkjs": "0.7.6"
  },
  "scripts": {
    "generate-inputs": "node scripts/generate_inputs.js",
    "validate:paper": "python3 scripts/validate_circuits.py --scope all",
    "run:paper": "python3 scripts/run_bench.py --scope all",
    "reproduce:paper": "python3 scripts/reproduce_paper.py",
    "run:rq1-rq2": "python3 scripts/run_bench.py --scope rq1-rq2",
    "run:rq3": "python3 scripts/run_bench.py --scope rq3",
    "smoke:rq3": "python3 scripts/run_bench.py --scope rq3 --repeats 3 --warmups 1 --blocks 1 --force-rebuild",
    "test:python": "python3 -m unittest discover -s tests"
  }
}
